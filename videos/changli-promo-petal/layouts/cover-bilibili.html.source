<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><script src="assets/gsap.min.js"></script><style>@font-face{font-family:'Noto Sans SC';src:url('assets/NotoSansSC-promo.ttf') format('truetype');font-weight:100 900;font-style:normal;font-display:block}*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;background:#FFF7EF;font-family:'Noto Sans SC',sans-serif;color:#5D3737}#root{position:relative;width:100%;height:100%;overflow:hidden}.cover-halo{position:absolute;left:365px;top:165px;width:790px;height:625px;border-radius:50%;background:#FFE1D5}.cover-model{position:absolute;left:368px;top:56px;width:860px;height:860px;clip-path:inset(0 7% 0 0)}.cover-copy{position:absolute;left:72px;top:212px;z-index:4}h1{margin:0;font-size:134px;font-weight:900;line-height:1.08;letter-spacing:-7px}h1 span{display:block}.cover-badge{display:inline-block;margin-top:38px;padding:16px 32px;border:3px solid #5D3737;border-radius:999px;background:#F37D6B;font-size:39px;font-weight:750}.cover-logo{position:absolute;left:77px;top:93px;width:78px;border-radius:22px}.cover-orb{position:absolute;width:122px;height:46px;border:2px solid #F37D6B;border-radius:999px;right:95px;top:110px;rotate:-18deg}</style></head><body><div id="root" data-composition-id="cover" data-width="1200" data-height="900" data-duration="1"><div class="cover-halo"></div><div class="cover-orb"></div><img class="cover-logo" src="assets/icon.png" alt=""><img class="cover-model" src="assets/hero.png" alt="当前桌宠实际模型"><div class="cover-copy"><h1><span>离火</span><span>长明</span></h1><span class="cover-badge">免费公测</span></div></div><script>window.__timelines['cover']=gsap.timeline({paused:true});</script></body></html>